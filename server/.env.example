DATABASE_URL = "postgresql://hotspots:change-me@localhost:5434/hotspots_dev?schema=public"
POSTGRES_USER = hotspots
POSTGRES_PASSWORD = change-me
POSTGRES_DB = hotspots_dev

PORT = 3000

# Signs login tokens. Use a long random value, at least 32 characters, e.g. from:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET = change-me-to-a-long-random-value
