generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  spots        Spot[]
}

enum Category {
  Restaurant
  Cafe
  Bar
  Park
  Shop
  Entertainment
  Other
}

model Spot {
  id            Int      @id @default(autoincrement())
  name          String
  category      Category
  address       String
  latitude      Float?
  longitude     Float?
  googlePlaceId String?  @unique
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
}
